# =====================================================================
# Sompo AgroPredict - Configuração de Ambiente
# =====================================================================

# Backend (sqlite | oracle) - use "sqlite" para testes locais
DB_BACKEND=sqlite

# SQLite (fallback) - local onde o banco será criado
SQLITE_PATH=data/agropredict_local.db

# Oracle (opcional - usado apenas se DB_BACKEND=oracle)
# ORACLE_USER=RM573998
# ORACLE_PASSWORD=261191
# ORACLE_DSN=localhost:1521/XE

# JWT - qualquer chave para testes
JWT_SECRET_KEY=chave-secreta-teste-123

# API - limite de requisições por minuto
API_RATE_LIMIT=10